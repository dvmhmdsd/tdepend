{
  "name": "tdepend",
  "version": "0.3.0",
  "description": "JDepend-inspired dependency analysis tool for TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tdepend": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "ts-node src/cli/index.ts analyze --help",
    "cli": "node dist/cli/index.js",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "keywords": [
    "dependency",
    "analysis",
    "typescript",
    "cli",
    "library",
    "api",
    "jdepend",
    "metrics",
    "architecture",
    "coupling",
    "abstractness",
    "instability",
    "dependency-analysis",
    "code-quality"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dvmhmdsd/tdepend.git"
  },
  "bugs": {
    "url": "https://github.com/dvmhmdsd/tdepend/issues"
  },
  "homepage": "https://github.com/dvmhmdsd/tdepend#readme",
  "author": "Mohamed Saad <mohamed.tarif999@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.0",
    "picomatch": "^4.0.0",
    "typescript": "5.9.3",
    "yaml": "^2.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/glob": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "0.28.2",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "vitest": "^5.0.0"
  }
}
